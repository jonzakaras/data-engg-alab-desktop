// Copy this file to <your-repo>/.devcontainer/devcontainer.json, and copy
// DESKTOP_BOOTSTRAP.md into your repo too — it's the copy-paste auth guide
// for engineers onboarding onto this desktop. Set AWS_PROFILE below to your
// SSO profile name; everything else works as-is.
{
  "name": "alab-desktop",

  // Bump the tag as new alab-desktop releases come out. Pin to a semver tag
  // (e.g. "1.2.3") for stability, or use "latest" to always track main.
  "image": "ghcr.io/jonzakaras/alab-desktop:latest",

  "remoteUser": "vscode",

  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "AWS_PROFILE": "<your-sso-profile-name>"

    // dbt MCP needs nothing here: it's dbt Platform's hosted MCP server,
    // reached over HTTP at our account's Access URL and configured entirely
    // in .mcp.json. Auth is OAuth — the first dbt MCP tool call in Claude
    // opens a browser to sign in, and the token is cached in
    // /home/vscode/.claude (the named volume below), so it survives rebuilds.
  },

  // Mounts your host's ~/.aws and ~/.dbt into the container (read-write, so
  // `aws sso login`/`dbt init` can refresh them from inside the container
  // too, not just the host) — see DESKTOP_BOOTSTRAP.md for the one-time
  // host-side setup each of these expects. ~/.dbt is for the dbt CLI
  // (dbt_cloud.yml); the dbt MCP server's OAuth token lives in the
  // /home/vscode/.claude volume instead, since Claude Code owns that flow.
  //
  // ${localEnv:HOME}${localEnv:USERPROFILE} is the devcontainer spec's own
  // documented cross-platform pattern: HOME is set on macOS/Linux/WSL and
  // blank on native Windows; USERPROFILE is the reverse. Concatenating both
  // always resolves to the right one. Using just ${localEnv:HOME} breaks
  // this mount silently on a non-WSL Windows setup.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.aws,target=/home/vscode/.aws,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.dbt,target=/home/vscode/.dbt,type=bind"
  ],

  "postCreateCommand": "bash /usr/local/share/alab-desktop/bootstrap.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbtLabsInc.dbt",
        "sqlfluff.vscode-sqlfluff",
        "ms-python.python",
        "anthropic.claude-code",
        "GitHub.vscode-pull-request-github",
        "AmazonWebServices.aws-toolkit-vscode",
        "esbenp.prettier-vscode"
      ],
      // The extension spawns this binary directly — it doesn't see the
      // `dbtf` shell alias, so this setting is what actually matters.
      "settings": {
        "dbt.dbtPath": "/home/vscode/.local/share/dbt-fusion/bin/dbt",
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  }
}
